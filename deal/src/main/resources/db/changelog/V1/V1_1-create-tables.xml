<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1.0-create-client-credit-statement" author="Win122333">

        <createTable tableName="client">
            <column name="client_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="account_number" type="VARCHAR(255)"/>
            <column name="birth_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="dependent_amount" type="INTEGER"/>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="employment_id" type="JSONB"/>
            <column name="first_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="gender" type="VARCHAR(255)"/>
            <column name="last_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="marital_status" type="VARCHAR(255)"/>
            <column name="middle_name" type="VARCHAR(255)"/>
            <column name="passport_id" type="JSONB"/>
        </createTable>

        <createTable tableName="credit">
            <column name="credit_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="amount" type="NUMERIC(38, 2)"/>
            <column name="credit_status" type="VARCHAR(255)"/>
            <column name="insurance_enabled" type="BOOLEAN"/>
            <column name="monthly_payment" type="NUMERIC(38, 2)"/>
            <column name="payment_schedule" type="JSONB"/>
            <column name="psk" type="NUMERIC(38, 2)"/>
            <column name="rate" type="NUMERIC(38, 2)"/>
            <column name="salary_client" type="BOOLEAN"/>
            <column name="term" type="INTEGER"/>
        </createTable>

        <createTable tableName="statement">
            <column name="statement_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="applied_offer" type="JSONB"/>
            <column name="creation_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="ses_code" type="VARCHAR(255)"/>
            <column name="sign_date" type="TIMESTAMP WITH TIME ZONE"/>
            <column name="status" type="VARCHAR(255)"/>
            <column name="status_history" type="JSONB"/>
            <column name="client_id" type="UUID"/>
            <column name="credit_id" type="UUID"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="statement" baseColumnNames="client_id"
                                 constraintName="fk_statement_client"
                                 referencedTableName="client" referencedColumnNames="client_id"/>

        <addForeignKeyConstraint baseTableName="statement" baseColumnNames="credit_id"
                                 constraintName="fk_statement_credit"
                                 referencedTableName="credit" referencedColumnNames="credit_id"/>

    </changeSet>
</databaseChangeLog>